 105          // 发送字符串到命令行
 106          char command[100];
 107          void str2cmd(const char *str) {
 108   1          while(*str != '\0') {
 109   2              // 1 - 9
 110   2              if((*str < ('9' + 1)) && (*str > ('0'))) {
 111   3                  HID_KEY_CTRL = KEY_Left_Shift;
 112   3                  HID_KEY_MAIN = *str - 19;      // 对应HID值 (数字)
 113   3                  KeyAction(1);
 114   3              } else if(*str == '0') {
C51 COMPILER V9.57.0.0   MAIN_                                                             03/02/2021 14:51:08 PAGE 3   

 115   3                  HID_KEY_CTRL = KEY_Left_Shift;
 116   3                  HID_KEY_MAIN = KEY_0;
 117   3                  KeyAction(1);
 118   3              } else if((*str < ('Z' + 1)) && (*str > ('A' - 1))) {
 119   3                  HID_KEY_CTRL = KEY_NULL;
 120   3                  HID_KEY_MAIN = *str - 61;      // 对应HID值 (字母)
 121   3                  KeyAction(1);
 122   3              } else if((*str < ('z' + 1)) && (*str > ('a' - 1))) {
 123   3                  HID_KEY_CTRL = KEY_Left_Shift;
 124   3                  HID_KEY_MAIN = *str - 61 - 32; // 对应HID值 (字母)
 125   3                  KeyAction(1);
 126   3              } else if((*str == ' ')) {
 127   3                  HID_KEY_CTRL = KEY_NULL;
 128   3                  HID_KEY_MAIN = KEY_SPACE;      // 对应HID值 (空格)
 129   3                  KeyAction(1);
 130   3              } else if((*str == '-')) {
 131   3                  HID_KEY_CTRL = KEY_NULL;
 132   3                  HID_KEY_MAIN = KEY_SUB;        // 对应HID值 (-)
 133   3                  KeyAction(1);
 134   3              }
 135   2              str++;
 136   2          }
 137   1          HID_KEY_CTRL = KEY_NULL;
 138   1          HID_KEY_MAIN = KEY_ENTER;
 139   1          KeyAction(1);
 140   1      }
 141          #define sendCmd(str)       \
 142              sprintf(command, str); \
 143              str2cmd(command)
